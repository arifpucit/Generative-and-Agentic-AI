# --- Python virtual environment (created by `uv sync` — never commit this) ---
.venv/
venv/
env/

# --- Python bytecode / build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# --- Secrets: API keys must NEVER be committed ---
.env
.env.*
!.env.example
keys/
*.key

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
.virtual_documents/

# --- Local vector stores / databases generated by the notebooks ---
chroma_db*/
*.sqlite3
*.db

# --- Hugging Face / model caches ---
.cache/
models/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/
